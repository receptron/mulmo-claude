GEMINI_API_KEY=your_gemini_api_key_here

# Image-generation provider for the `generateImage` tool. Gemini is the
# default and needs GEMINI_API_KEY (above). Set MULMOCLAUDE_IMAGE_PROVIDER
# to `openai` to generate images via OpenAI instead — that path needs
# OPENAI_API_KEY. When the provider is unset, the first provider with a
# configured key wins (Gemini first). An explicit provider is honoured
# even if its key is missing (the call then fails with a clear error).
# Audio / video generation and the editImages tool stay Gemini-only.
# MULMOCLAUDE_IMAGE_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# MULMOCLAUDE_OPENAI_IMAGE_MODEL=gpt-image-1

# Client locale for vue-i18n. Supported: "en" (default), "ja".
# Picked up at build/dev time via import.meta.env.VITE_LOCALE.
# VITE_LOCALE=en

# CSRF-guard allowlist for cross-origin state-changing requests
# (POST/PUT/PATCH/DELETE). Localhost is always allowed; use this
# to permit a LAN device (e.g. an iPad) to reach `yarn dev` from
# another machine. Comma-separated, verbatim match against the
# `Origin` header — include the scheme and port and do NOT add a
# trailing slash. The literal string `null` is rejected even if
# listed (it's what browsers send for sandboxed iframes / file:// /
# data: pages, which must never be honored as a trusted origin).
# Example:
# MULMOCLAUDE_TRUSTED_ORIGINS=http://192.168.1.42:5173
