{
  "name": "@mulmoclaude/markdown-utils",
  "version": "1.3.0",
  "description": "Browser-safe markdown / image rendering utilities shared by the MulmoClaude host and the markdown plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "dependencies": {
    "@mulmoclaude/common": "^1.1.0",
    "js-yaml": "^5.2.2",
    "marked": "^18.0.7"
  },
  "peerDependencies": {
    "mermaid": "^11.16.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "mermaid": "^11.16.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40"
  }
}
